          "children": [
            {
              "type": "text",
              "id": "NjYlM",
              "name": "storyEyebrow",
              "fill": "#8B6F47",
              "content": "ABOUT YUIAN",
              "fontFamily": "Cormorant Garamond",
              "fontSize": 20,
              "fontWeight": "500",
              "letterSpacing": 0.02
            },
            {
              "type": "text",
              "id": "Rs7xD",
              "name": "storyTitle",
              "fill": "#1A1A1A",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "都会から、吉野の山へ。",
              "lineHeight": 1.24,
              "fontFamily": "Noto Serif JP",
              "fontSize": 52,
              "fontWeight": "600",
              "letterSpacing": 0.05
            },
            {
              "type": "text",
              "id": "hLYIt",
              "name": "p1",
              "fill": "#5C5C5C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "都会で疲れた夫婦が、吉野山の桜を見に来た日から、暮らしの時間は静かに変わり始めました。",
              "lineHeight": 1.75,
              "fontFamily": "Noto Sans JP",
              "fontSize": 17,
              "letterSpacing": 0.05
            },
            {
              "type": "text",
              "id": "l7sZE",
              "name": "p2",
              "fill": "#5C5C5C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "朽ちかけていた庄屋邸に出会い、壁の土を塗り、瓦を集め、三年をかけて少しずつ庵を起こしました。",
              "lineHeight": 1.75,
              "fontFamily": "Noto Sans JP",
              "fontSize": 17,
              "letterSpacing": 0.05
            },
            {
              "type": "text",
              "id": "tZlBJ",
              "name": "p3",
              "fill": "#5C5C5C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "残したのは梁と欄間と土壁。加えたのは、今の暮らしに合う椅子と、夜をやわらげる灯りです。",
              "lineHeight": 1.75,
              "fontFamily": "Noto Sans JP",
              "fontSize": 17,
              "letterSpacing": 0.05
            },
            {
              "type": "text",
              "id": "A9rBn",
              "name": "p4",
              "fill": "#5C5C5C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "ここに来てくれた人に、時間を返したい。その思いだけを、今日も湯気にのせてお出ししています。",
              "lineHeight": 1.75,
              "fontFamily": "Noto Sans JP",
              "fontSize": 17,
              "letterSpacing": 0.05
            }
          ]
        },
